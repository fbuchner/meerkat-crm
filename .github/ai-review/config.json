{
  "models": ["z-ai/glm-5.3", "deepseek/deepseek-v4-pro-0813"],
  "provider_quantizations": ["fp8", "fp16", "bf16", "fp32", "unknown"],
  "reasoning_effort": "high",
  "max_output_tokens": 32000,
  "request_timeout_seconds": 600,
  "deadline_seconds": 900,
  "fail_on": "blocker",
  "max_diff_chars": 400000,
  "max_context_chars": 300000,
  "max_context_file_chars": 60000,
  "max_description_chars": 8000,
  "max_inline_comments": 25,
  "status_context": "ai-review",
  "trigger_label": "ai-review",
  "human_review_label": "needs-human-review",
  "trusted_associations": ["OWNER", "MEMBER", "COLLABORATOR"],
  "trusted_authors": ["omarkohl", "ymage", "claude[bot]"],
  "skip_authors": ["dependabot[bot]"],
  "ignored_paths": ["frontend/yarn.lock", "backend/go.sum", "*.snap"],
  "human_review_risk_flags": [
    "security-sensitive",
    "auth",
    "data-migration",
    "public-api-change",
    "new-dependency",
    "test-weakening"
  ],
  "human_review_paths": [
    ".github/*",
    "*CODEOWNERS",
    "LICENSE*",
    "*Dockerfile*",
    "docker-compose*",
    "backend/database/migrations/*",
    "backend/go.mod",
    "backend/go.sum",
    "frontend/package.json",
    "frontend/yarn.lock",
    "frontend/e2e/*",
    "backend/middleware/auth*",
    "backend/carddav/auth*",
    "backend/controllers/oidc*",
    "backend/controllers/api_token*",
    "backend/services/oidc*",
    "backend/services/password_reset*",
    "frontend/src/auth*",
    "frontend/src/api/auth*"
  ]
}
