  "descriptions": {
    "bone": "Primary application background",
    "parchment": "Sidebars, cards, structural containers",
    "paper": "Elevated dialogs, floating elements",
    "hypha": "Borders, dividers, subtle outlines",
    "lichen": "Secondary accents, hover states",
    "mycelium": "Brand primary, navigation, active controls",
    "bark": "Primary text and heavy icons",
    "soil": "Secondary text, muted descriptions",
    "russula": "Error / destructive status (mushroom-themed status color)",
    "chanterelle": "Warning status (mushroom-themed status color)",
    "inkyCap": "Info status (mushroom-themed status color)",
    "moss": "Success status -- deliberately a different hue/chroma from mycelium/lichen so it reads as a distinct signal, not a brand-color shade"
  },
